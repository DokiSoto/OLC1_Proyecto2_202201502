    // TAREA DE ARRANQUE: WHILE Y RECURSOS
    print("--- TAREA DE ARRANQUE: WHILE Y RECURSOS ---");

    run levantar;

    // Ciclo while y actualizacion de variables: 1.5 puntos.
    bool cumplePrueba20 = visitasPreparacion == 2 && iniciados == 2 && memoriaPreparada == 12;
    print("  visitasPreparacion | esperado=2 | observado=" + (visitasPreparacion));
    print("  iniciados | esperado=2 | observado=" + (iniciados));
