        aprobadas = aprobadas + 1;
    }
    print("Indices calculados sobre el plan | cumple=" + cumplePrueba6 + " | puntos=" + ganadoPrueba6 + "/0.5");

    int minimoSinParametros = memoriaMinima();
    bool permisoSinParametros = permitirDespliegue();

    // Funciones sin parametros: 0.5 puntos.
    bool cumplePrueba7 = minimoSinParametros == 4;
    print("  minimoSinParametros | esperado=4 | observado=" + (minimoSinParametros));
    float ganadoPrueba7 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba7) {
