    if (cumplePrueba11) {
        ganadoPrueba11 = 0.5;
        puntajeCriterio5 = puntajeCriterio5 + ganadoPrueba11;
        puntos = puntos + ganadoPrueba11;
        aprobadas = aprobadas + 1;
    }
    print("Parametro float y costo retornado | cumple=" + cumplePrueba11 + " | puntos=" + ganadoPrueba11 + "/0.5");

    // Funciones: parametros tipados y return: 0.5 puntos.
    bool cumplePrueba12 = capacidadValida;
    print("  capacidadValida | esperado=true | observado=" + (capacidadValida));
