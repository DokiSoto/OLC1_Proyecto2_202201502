    }
    print("Parametro server para consultar capacidad | cumple=" + cumplePrueba12 + " | puntos=" + ganadoPrueba12 + "/0.5");

    // Funciones: parametros tipados y return: 0.5 puntos.
    bool cumplePrueba13 = sumaPlan == 9;
