    }
    print("While prepara los dos servidores del arreglo | cumple=" + cumplePrueba20 + " | puntos=" + ganadoPrueba20 + "/1.5");

    bool mantenimientoPendiente = false;
    int revisionesExtra = 0;
    while (mantenimientoPendiente) {
        revisionesExtra = revisionesExtra + 1;
        mantenimientoPendiente = false;
    }

    // Ciclo while y actualizacion de variables: 0.5 puntos.
    bool cumplePrueba21 = revisionesExtra == 0;
    print("  revisionesExtra | esperado=0 | observado=" + (revisionesExtra));
    float ganadoPrueba21 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba21) {
        ganadoPrueba21 = 0.5;
        puntajeCriterio1 = puntajeCriterio1 + ganadoPrueba21;
        puntos = puntos + ganadoPrueba21;
        aprobadas = aprobadas + 1;
    }
    print("While no ejecuta mantenimiento deshabilitado | cumple=" + cumplePrueba21 + " | puntos=" + ganadoPrueba21 + "/0.5");

    // Declaracion de task y ejecucion mediante run: 0.75 puntos.
    bool cumplePrueba22 = pasos == 1 && traza == "levantar;" && servidorWeb.status == "running" && servidorReserva.status == "running";
    print("  pasos | esperado=1 | observado=" + (pasos));
    print("  traza | esperado=levantar; | observado=" + (traza));
    float ganadoPrueba22 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba22) {
        ganadoPrueba22 = 0.75;
        puntajeCriterio7 = puntajeCriterio7 + ganadoPrueba22;
        puntos = puntos + ganadoPrueba22;
        aprobadas = aprobadas + 1;
    }
    print("Primera tarea establece el estado para la siguiente | cumple=" + cumplePrueba22 + " | puntos=" + ganadoPrueba22 + "/0.75");

    // TAREA DE PAQUETES: FOR, BREAK, CONTINUE Y FUNCIONES
    print("--- TAREA DE PAQUETES: FOR, BREAK, CONTINUE Y FUNCIONES ---");

    run preparar;

    // Ciclo for (inicializacion, condicion y cambio): 1.5 puntos.
    bool cumplePrueba23 = trazaPaquetes == "0;1;2;3;4;" && paquetesVisitados == 5;
    print("  trazaPaquetes | esperado=0;1;2;3;4; | observado=" + (trazaPaquetes));
    print("  paquetesVisitados | esperado=5 | observado=" + (paquetesVisitados));
    float ganadoPrueba23 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba23) {
        ganadoPrueba23 = 1.5;
        puntajeCriterio2 = puntajeCriterio2 + ganadoPrueba23;
        puntos = puntos + ganadoPrueba23;
        aprobadas = aprobadas + 1;
    }
    print("For recorre el plan y actualiza su indice tras continue | cumple=" + cumplePrueba23 + " | puntos=" + ganadoPrueba23 + "/1.5");

    int extrasVisitados = 0;
    for (int i = length(planPaquetes); i < length(planPaquetes); i = i + 1) {
