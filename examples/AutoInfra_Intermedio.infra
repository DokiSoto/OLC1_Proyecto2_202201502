    }
    print("Funcion sin parametros que lee la configuracion | cumple=" + cumplePrueba7 + " | puntos=" + ganadoPrueba7 + "/0.5");

    // Funciones sin parametros: 0.5 puntos.
    bool cumplePrueba8 = permisoSinParametros;
    print("  permisoSinParametros | esperado=true | observado=" + (permisoSinParametros));
    float ganadoPrueba8 = 0.0;
    comprobaciones = comprobaciones + 1;
