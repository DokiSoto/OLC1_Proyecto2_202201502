    }
    print("Lectura de la configuracion global | cumple=" + cumplePrueba14 + " | puntos=" + ganadoPrueba14 + "/0.5");

    int resultadoAmbito = probarAmbitos(6);

    // Ambitos globales, locales y de funcion: 1 puntos.
