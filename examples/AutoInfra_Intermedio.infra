    bool ejecutaAnd = true && esApto(servidorWeb, 4);
    bool ejecutaOr = false || esApto(servidorWeb, 4);

    // Evaluacion de corto circuito (&& y ||): 0.75 puntos.
    bool cumplePrueba19 = ejecutaAnd && ejecutaOr && consultas == 2;
    print("  consultas realizadas | esperado=2 | observado=" + (consultas));
    float ganadoPrueba19 = 0.0;
