    }
    print("Parametro bool selecciona el retorno inmediato | cumple=" + cumplePrueba10 + " | puntos=" + ganadoPrueba10 + "/1");

    // Funciones: parametros tipados y return: 0.5 puntos.
    bool cumplePrueba11 = costoCalculado == 7.5;
    print("  costoCalculado | esperado=7.5 | observado=" + (costoCalculado));
    float ganadoPrueba11 = 0.0;
