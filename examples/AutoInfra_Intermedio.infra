    }
    print("Funcion sin parametros con retorno bool | cumple=" + cumplePrueba8 + " | puntos=" + ganadoPrueba8 + "/0.5");

    int replicasAumentadas = calcularReplicas(2, 2, true);
    int replicasConservadas = calcularReplicas(2, 2, false);
    float costoCalculado = estimarCosto(2.5, 3);
    bool capacidadValida = esApto(servidorWeb, 8);
    int sumaPlan = sumarObjetivos(objetivos);

    // Funciones: parametros tipados y return: 1 puntos.
    bool cumplePrueba9 = replicasAumentadas == 4;
    print("  replicasAumentadas | esperado=4 | observado=" + (replicasAumentadas));
    float ganadoPrueba9 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba9) {
        ganadoPrueba9 = 1.0;
        puntajeCriterio5 = puntajeCriterio5 + ganadoPrueba9;
        puntos = puntos + ganadoPrueba9;
        aprobadas = aprobadas + 1;
    }
    print("Parametros int para calcular replicas | cumple=" + cumplePrueba9 + " | puntos=" + ganadoPrueba9 + "/1");

    // Funciones: parametros tipados y return: 1 puntos.
    bool cumplePrueba10 = replicasConservadas == 2;
    print("  replicasConservadas | esperado=2 | observado=" + (replicasConservadas));
    float ganadoPrueba10 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba10) {
        ganadoPrueba10 = 1.0;
        puntajeCriterio5 = puntajeCriterio5 + ganadoPrueba10;
