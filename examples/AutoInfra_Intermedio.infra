    // Arreglos: tipos, literales, indices y length: 0.5 puntos.
    bool cumplePrueba5 = length(servidores) == 2 && servidores[0] == servidorWeb && servidores[1].cpu == 2;
    print("  servidores[1].cpu | esperado=2 | observado=" + (servidores[1].cpu));
    float ganadoPrueba5 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba5) {
        ganadoPrueba5 = 0.5;
        puntajeCriterio4 = puntajeCriterio4 + ganadoPrueba5;
