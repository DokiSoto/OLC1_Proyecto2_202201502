    print("AUTOINFRA - INTERMEDIO ACUMULATIVO");
    print("Preparar servidores, seleccionar paquetes y desplegar una API mediante tareas.");
    print("Puntaje automatico disponible: 30.");

    // PLAN DE PREPARACION Y PARAMETROS
    print("--- PLAN DE PREPARACION Y PARAMETROS ---");

    // Arreglos: tipos, literales, indices y length: 0.75 puntos.
    bool cumplePrueba1 = length(objetivos) == 3 && objetivos[0] == 2 && objetivos[2] == 4;
    print("  objetivos[0] | esperado=2 | observado=" + (objetivos[0]));
    print("  objetivos[2] | esperado=4 | observado=" + (objetivos[2]));
    float ganadoPrueba1 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba1) {
        ganadoPrueba1 = 0.75;
        puntajeCriterio4 = puntajeCriterio4 + ganadoPrueba1;
        puntos = puntos + ganadoPrueba1;
        aprobadas = aprobadas + 1;
    }
    print("Arreglo int utilizado como plan de replicas | cumple=" + cumplePrueba1 + " | puntos=" + ganadoPrueba1 + "/0.75");

    // Arreglos: tipos, literales, indices y length: 0.5 puntos.
    bool cumplePrueba2 = length(tarifas) == 3 && tarifas[1] == 2.5;
    print("  tarifa seleccionada | esperado=2.5 | observado=" + (tarifas[1]));
    float ganadoPrueba2 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba2) {
        ganadoPrueba2 = 0.5;
        puntajeCriterio4 = puntajeCriterio4 + ganadoPrueba2;
        puntos = puntos + ganadoPrueba2;
        aprobadas = aprobadas + 1;
    }
    print("Arreglo float utilizado para el costo | cumple=" + cumplePrueba2 + " | puntos=" + ganadoPrueba2 + "/0.5");

    // Arreglos: tipos, literales, indices y length: 0.5 puntos.
    bool cumplePrueba3 = length(habilitados) == 3 && habilitados[0] && !habilitados[1] && habilitados[2];
    print("  habilitados[1] | esperado=false | observado=" + (habilitados[1]));
    float ganadoPrueba3 = 0.0;
    comprobaciones = comprobaciones + 1;
    if (cumplePrueba3) {
        ganadoPrueba3 = 0.5;
        puntajeCriterio4 = puntajeCriterio4 + ganadoPrueba3;
        puntos = puntos + ganadoPrueba3;
        aprobadas = aprobadas + 1;
    }
    print("Arreglo bool con decisiones habilitadas y omitidas | cumple=" + cumplePrueba3 + " | puntos=" + ganadoPrueba3 + "/0.5");

    string[] etiquetas = ["principal", "reserva"];

    // Arreglos: tipos, literales, indices y length: 0.75 puntos.
    bool cumplePrueba4 = length(planPaquetes) == 5 && planPaquetes[1] == "temporal" && etiquetas[1] == "reserva";
    print("  etiqueta reserva | esperado=reserva | observado=" + (etiquetas[1]));
    print("  paquete omitible | esperado=temporal | observado=" + (planPaquetes[1]));
    float ganadoPrueba4 = 0.0;
