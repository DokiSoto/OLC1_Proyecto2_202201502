        puntos = puntos + ganadoPrueba15;
        aprobadas = aprobadas + 1;
    }
    print("Parametros y locales no modifican la configuracion global | cumple=" + cumplePrueba15 + " | puntos=" + ganadoPrueba15 + "/1");

    bool alcanceBloque = false;
    if (true) {
