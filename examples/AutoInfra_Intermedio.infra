/*
AUTOINFRA - INTERMEDIO ACUMULATIVO
*/

server servidorWeb {
    cpu = 4;
    memory = 8;
    disk = 100;
    os = "ubuntu";
}
server servidorReserva {
    cpu = 2;
    memory = 4;
    disk = 50;
    os = "ubuntu";
}
service api {
    port = 8080;
    replicas = 1;
}

server[] servidores = [servidorWeb, servidorReserva];
int[] objetivos = [2, 3, 4];
float[] tarifas = [1.5, 2.5, 3.5];
bool[] habilitados = [true, false, true];
string[] planPaquetes = ["docker", "temporal", "git", "nginx", "posterior"];
int minimoMemoria = 4;
int consultas = 0;
int iniciados = 0;
int visitasPreparacion = 0;
int memoriaPreparada = 0;
int paquetesInstalados = 0;
int paquetesOmitidos = 0;
int paquetesVisitados = 0;
int rupturaEn = -1;
int pasos = 0;
int replicasObjetivo = 0;
float costo = 0.0;
string traza = "";
string trazaPaquetes = "";
bool despliegueCorrecto = false;
bool escalaCorrecta = false;

function memoriaMinima() int {
    return minimoMemoria;
}
function permitirDespliegue() bool {
    return true;
}
function calcularReplicas(int base, int extra, bool aumentar) int {
    if (aumentar) {
        return base + extra;
    }
    return base;
}
function estimarCosto(float tarifa, int cantidad) float {
    return tarifa * cantidad;
}
function esApto(server equipo, int minimo) bool {
    consultas = consultas + 1;
    return equipo.memory >= minimo && equipo.os == "ubuntu";
}
function sumarObjetivos(int[] valores) int {
    int suma = 0;
    for (int i = 0; i < length(valores); i = i + 1) {
        suma = suma + valores[i];
    }
    return suma;
}
function probarAmbitos(int minimoMemoria) int {
    int suma = minimoMemoria;
    if (true) {
        int minimoMemoria = 12;
        suma = suma + minimoMemoria;
    }
    return suma + minimoMemoria + memoriaMinima();
}
function contienePaquete(server equipo, string nombre) bool {
    for (int i = 0; i < length(equipo.packages); i = i + 1) {
        if (equipo.packages[i] == nombre) {
            return true;
        }
    }
    return false;
}
function configurar(server equipo, string[] paquetes, int maximo) int {
    int instalados = 0;
    for (int i = 0; i < length(paquetes); i = i + 1) {
        paquetesVisitados = paquetesVisitados + 1;
        trazaPaquetes = trazaPaquetes + i + ";";
        if (paquetes[i] == "temporal") {
            paquetesOmitidos = paquetesOmitidos + 1;
            continue;
        }
        if (instalados >= maximo) {
            rupturaEn = i;
            break;
        }
        bool instalado = install(equipo, paquetes[i]);
        if (instalado) {
            instalados = instalados + 1;
        }
    }
    return instalados;
}

task levantar {
    int i = 0;
    while (i < length(servidores)) {
        visitasPreparacion = visitasPreparacion + 1;
        if (servidores[i].status == "stopped") {
            bool inicio = start(servidores[i]);
            if (inicio) {
                iniciados = iniciados + 1;
            }
        }
        memoriaPreparada = memoriaPreparada + servidores[i].memory;
        i = i + 1;
    }
    pasos = pasos + 1;
    traza = traza + "levantar;";
}
task preparar {
    paquetesInstalados = configurar(servidorWeb, planPaquetes, 3);
    costo = estimarCosto(tarifas[1], paquetesInstalados);
    pasos = pasos + 1;
    traza = traza + "preparar;";
}
task desplegar {
    if (permitirDespliegue() && esApto(servidorWeb, memoriaMinima())) {
        despliegueCorrecto = deploy(servidorWeb, api);
        replicasObjetivo = calcularReplicas(objetivos[0], objetivos[0], habilitados[0]);
        if (replicasObjetivo >= 1 && api.status == "running") {
            escalaCorrecta = scale(api, replicasObjetivo);
        }
    }
    pasos = pasos + 1;
    traza = traza + "desplegar;";
}

main {
    float puntos = 0.0;
    int comprobaciones = 0;
    int aprobadas = 0;

    float puntajeCriterio1 = 0.0;

    float puntajeCriterio2 = 0.0;

    float puntajeCriterio3 = 0.0;

    float puntajeCriterio4 = 0.0;

    float puntajeCriterio5 = 0.0;

    float puntajeCriterio6 = 0.0;

