        aprobadas = aprobadas + 1;
    }
    print("Arreglo de servidores para la preparacion | cumple=" + cumplePrueba5 + " | puntos=" + ganadoPrueba5 + "/0.5");

    // Arreglos: tipos, literales, indices y length: 0.5 puntos.
    bool cumplePrueba6 = objetivos[1 + 1] == 4 && planPaquetes[length(planPaquetes) - 1] == "posterior";
    print("  ultimo paquete | esperado=posterior | observado=" + (planPaquetes[length(planPaquetes) - 1]));
    float ganadoPrueba6 = 0.0;
    comprobaciones = comprobaciones + 1;
